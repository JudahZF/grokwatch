// Signing identity for both targets.
// Do not edit this file for your own build. Create Local.xcconfig next to it
// (git ignores it) and set DEVELOPMENT_TEAM and BUNDLE_ID_PREFIX there.
DEVELOPMENT_TEAM =
BUNDLE_ID_PREFIX = com.example

APP_BUNDLE_ID = $(BUNDLE_ID_PREFIX).grokwatch
APP_GROUP_ID = group.$(APP_BUNDLE_ID)

#include? "Local.xcconfig"
